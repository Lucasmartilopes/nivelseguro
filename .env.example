# ============================================================
# Copie este arquivo para .env e troque as senhas:
#   cp .env.example .env
#   nano .env
# O arquivo .env NAO vai para o GitHub (esta no .gitignore).
# Use apenas letras e numeros nas senhas (evite $ # " ' espaco).
# ============================================================

# Senha do usuario root do MySQL (usada apenas pelo container do banco)
MYSQL_ROOT_PASSWORD=TroqueRoot2026

# Banco e usuario da aplicacao (a API conecta com este usuario, nao com o root)
MYSQL_DATABASE=nivelseguro
MYSQL_USER=nivelseguro
MYSQL_PASSWORD=TroqueApp2026
